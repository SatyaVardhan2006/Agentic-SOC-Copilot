# Agentic SOC Copilot Environment Configuration
# Note: If OPENAI_API_KEY is omitted or blank, the copilot automatically runs in
# high-fidelity DETERMINISTIC FALLBACK mode, producing realistic SOC outputs without errors.

# Optional: OpenAI API Key for live LLM reasoning (leave blank for deterministic demo mode)
OPENAI_API_KEY=

# Optional: Model selection (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Server Port (optional, defaults to 8000)
PORT=8000
